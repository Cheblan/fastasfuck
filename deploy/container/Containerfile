# fastasfuck release container image: server and tools built natively on Arch Linux for AMD Strix Halo (gfx1151).
# Weights are not included in the image - mount your model directory at /models.
#
# Run (podman or docker):
#   podman run -d --name fastasfuck \
#       --device /dev/kfd --device /dev/dri \
#       --security-opt seccomp=unconfined \
#       -p 5300:5300 \
#       -v /path/to/models:/models \
#       ghcr.io/cheblan/fastasfuck:latest
#
# Multi-stage build:
# 1. build: compiles fastasfuck on Arch Linux using native Arch ROCm packages (rocm-hip-sdk, rocm-llvm, cmake, ninja).
# 2. runtime: minimal Arch Linux base image with only the HIP runtime (hip-runtime-amd), keeping image lean (~1.18 GiB).

# --- Stage 1: Build ---
FROM docker.io/archlinux:base-devel AS build

# Install Arch ROCm development toolchain and build tools
RUN pacman -Syu --noconfirm && \
    pacman -S --noconfirm --needed \
        rocm-hip-sdk \
        rocm-llvm \
        cmake \
        ninja \
        git && \
    pacman -Scc --noconfirm

COPY . /src
WORKDIR /src

# Compile with preset strix (targets gfx1151 / Zen 5)
RUN cmake --preset strix -DSTRIX_DEV_TOOLS=OFF && \
    cmake --build --preset strix

# Stage binaries and configs
RUN mkdir -p /opt/fastasfuck/bin /opt/fastasfuck/share && \
    for b in fastasfuck_server inspect_faf convert_qwen4exp convert_ngram_table transcode_ngram_table; do \
        test -x build/strix/$b || { echo "Containerfile: build/strix/$b missing"; exit 1; }; \
        cp build/strix/$b /opt/fastasfuck/bin/; \
    done && \
    cp deploy/fastasfuck-server.conf /opt/fastasfuck/ && \
    cp LICENSE THIRD_PARTY.md /opt/fastasfuck/share/

# --- Stage 2: Runtime ---
FROM docker.io/archlinux:base AS runtime

# Install ONLY the runtime HIP stack (hip-runtime-amd) - NO bloated rocblas / miopen
RUN pacman -Syu --noconfirm && \
    pacman -S --noconfirm --needed \
        hip-runtime-amd && \
    pacman -Scc --noconfirm && \
    rm -rf /var/cache/pacman/pkg/* /var/lib/pacman/sync/* /tmp/*

COPY --from=build /opt/fastasfuck /opt/fastasfuck

ENV PATH=/opt/fastasfuck/bin:/usr/bin:/bin \
    LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/lib/llvm/lib:/usr/lib \
    STRIX_MODELS_DIR=/models \
    HSA_DISABLE_COREDUMP_ON_EXCEPTION=1

VOLUME /models
EXPOSE 5300

ENTRYPOINT ["/opt/fastasfuck/bin/fastasfuck_server", "--config", "/opt/fastasfuck/fastasfuck-server.conf"]
