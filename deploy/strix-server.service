[Unit]
Description=Strixite LLM Inference Engine (Qwen 3.8-Flash-Next on AMD Strix Halo gfx1151)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/strixite-main
LimitMEMLOCK=infinity
LimitNOFILE=1048576
Environment=HSA_OVERRIDE_GFX_VERSION=11.5.1
Environment=HSA_DISABLE_COREDUMP_ON_EXCEPTION=1
Environment=STRIX_WEIGHTS=/models/Thinking-Cap-Qwen-3.8-FN-strixw/weights.strixw
Environment=STRIX_EXTRA_ARGS=
ExecStart=%h/strixite-main/build/strix/strix_server --config %h/strix-server-hybrid.conf --weights ${STRIX_WEIGHTS} $STRIX_EXTRA_ARGS
TimeoutStopSec=90
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=4

[Install]
WantedBy=default.target
